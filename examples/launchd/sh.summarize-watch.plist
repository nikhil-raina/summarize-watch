<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly summarize-watch run at 03:00 local time (macOS launchd).

  1. Edit the two paths below (watch.yaml location and log folder).
  2. cp sh.summarize-watch.plist ~/Library/LaunchAgents/
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sh.summarize-watch.plist
  4. Run it once now:  launchctl kickstart -k gui/$(id -u)/sh.summarize-watch
  Remove with:        launchctl bootout gui/$(id -u)/sh.summarize-watch

  A login shell (zsh -lc) is used so nvm/Homebrew PATH entries are available to `summarize-watch`
  and `summarize`. Overlapping runs are refused by summarize-watch itself, so a slow night is safe.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.summarize-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>summarize-watch run --config "$HOME/watch/watch.yaml"</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/watch/state/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/watch/state/launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
