<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Nightly summarize-watch run at 03:00 local time (macOS launchd).

  launchd does not read your shell profile, and nvm is usually sourced from .zshrc, which even a
  login shell skips. So this file spells out PATH and calls the binary directly.

  1. Replace YOUR_USER and, if needed, the Node version in the two paths below.
     Find them with:  which summarize-watch   and   dirname "$(which node)"
  2. mkdir -p ~/watch/state && cp sh.summarize-watch.plist ~/Library/LaunchAgents/
  3. launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/sh.summarize-watch.plist
  4. Run it once now:  launchctl kickstart -k gui/$(id -u)/sh.summarize-watch
     Watch:            tail -f ~/watch/state/launchd.log
  Remove with:        launchctl bootout gui/$(id -u)/sh.summarize-watch

  Overlapping runs are refused by summarize-watch itself, so a slow night is safe.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>sh.summarize-watch</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/YOUR_USER/.nvm/versions/node/v24.21.0/bin/summarize-watch</string>
    <string>run</string>
    <string>--config</string>
    <string>/Users/YOUR_USER/watch/watch.yaml</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/Users/YOUR_USER/.nvm/versions/node/v24.21.0/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME</key>
    <string>/Users/YOUR_USER</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/YOUR_USER/watch/state/launchd.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/YOUR_USER/watch/state/launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
