#!/usr/bin/env bash
# A stand-in for the real `summarize` CLI. Behaviour is chosen with FAKE_SUMMARIZE_MODE:
#   success (default) | llm-null | extract | fail | hang | garbage | prefixed | usage
# FAKE_SUMMARIZE_VERSION overrides what --version prints; FAKE_SUMMARIZE_LOG appends each argv line.
set -uo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if [[ "${1:-}" == "--version" ]]; then
  printf '%s\n' "${FAKE_SUMMARIZE_VERSION:-0.23.1}"
  exit 0
fi
URL="${1:-}"
MODE="${FAKE_SUMMARIZE_MODE:-success}"
if [[ -n "${FAKE_SUMMARIZE_LOG:-}" ]]; then printf '%s\n' "$*" >> "$FAKE_SUMMARIZE_LOG"; fi

emit() {
  node -e '
    const fs = require("node:fs");
    const d = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
    d.input = Object.assign(d.input || {}, { url: process.argv[2] });
    d.extracted.url = process.argv[2];
    if (!/youtube\.com|youtu\.be|\.(mp3|m4a|mp4|wav)(\?|$)/.test(process.argv[2])) {
      d.extracted.video = null; d.extracted.transcriptSource = null; d.extracted.mediaDurationSeconds = null;
    }
    process.stdout.write(JSON.stringify(d, null, 2) + "\n");
  ' "$1" "$URL"
}

case "$MODE" in
  success)  emit "$DIR/envelope-success.json" ;;
  llm-null) emit "$DIR/envelope-llm-null.json" ;;
  extract)  emit "$DIR/envelope-extract.json" ;;
  prefixed) echo "Fetching https://example.com ..."; emit "$DIR/envelope-success.json" ;;
  garbage)  echo "Fetching ..."; echo "this is not json"; exit 0 ;;
  fail)     printf '\033[31mError:\033[0m No transcript available for this video\n' >&2; exit 1 ;;
  usage)    echo "error: unknown option '--bogus'" >&2; exit 2 ;;
  hang)     exec sleep 60 ;;
  *)        echo "fake-summarize: unknown mode $MODE" >&2; exit 2 ;;
esac
